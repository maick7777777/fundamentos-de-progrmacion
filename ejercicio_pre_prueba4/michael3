def validador_modelo(modelo):
    if modelo.strip()=="":
        return False
    else:
        return True
    

def validador_año(año):
    try:
        año=int(año)
        if año<1900:
            return False
        else:
            return True
    except ValueError:
        return False    

def validador_precio(precio):
    try:
        precio=float(precio)
        if precio<0:
            return False
        else:
            return True
    except ValueError:
        return False    

