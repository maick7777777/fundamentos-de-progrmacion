def unidades_tipo(tipo,DiccionarioArreglos,DicionariosBodega):
    acumulador=0
    tipo=tipo.strip().lower()
    for claveArreglos,valorArreglos in DiccionarioArreglos.items():
        if tipo==valorArreglos[1]:
            for claveBodega,valorBodega in DicionariosBodega.items():
                if claveBodega==claveArreglos:
                    acumulador+=valorBodega[1]
    print(f"El total de unidades disponibles es: {acumulador}")        


