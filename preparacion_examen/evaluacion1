def agregar_arreglo(codigo,nombre,tipo,color,tamaño,tarjeta,temporada,precio,unidades,DiccionarioArreglos,DiccionarioBodega):
    
    DiccionarioArreglos.setdefault(codigo ,[]).append([nombre,tipo,color,tamaño,tarjeta,temporada])
    DiccionarioBodega.setdefault(codigo, []).append([precio,unidades])
    return True

def eliminar_codigo(codigo,DiccionarioArreglo,DiccionarioBodega):
